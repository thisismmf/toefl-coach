# ---- Default provider / model (changeable live in the UI) ----
TOEFL_PROVIDER=ollama
TOEFL_MODEL=qwen3-vl:8b

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434

# ---- Ollama Cloud (gpt-oss, kimi-k2, glm, deepseek, qwen3.5 ...) ----
# Get a key at https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# ---- Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, LM Studio, vLLM...) ----
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# ---- Anthropic ----
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Server ----
TOEFL_HOST=127.0.0.1
TOEFL_PORT=8781
